#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 using roundrobin

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

$SUDO apt-get update -y
$SUDO apt-get install -y haproxy

if ! grep -q "web-backend" /etc/haproxy/haproxy.cfg; then
    $SUDO tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'

frontend http-in
    bind *:80
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    server 7408-web-01 18.171.55.145:80 check
    server 7408-web-02 35.178.40.132:80 check
EOF
fi

# Enable the init script on older Ubuntu versions (file may not exist)
[ -f /etc/default/haproxy ] && $SUDO sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy

$SUDO haproxy -c -f /etc/haproxy/haproxy.cfg
$SUDO service haproxy restart
