#!/usr/bin/env bash
# Configure Nginx to return the hostname in the X-Served-By header

set -e

apt-get update -y
apt-get install -y nginx

DEFAULT_SITE="/etc/nginx/sites-available/default"
NGINX_HOSTNAME="\$hostname"

if ! grep -q 'add_header X-Served-By' "$DEFAULT_SITE"; then
    sed -i "/server[[:space:]]*{/a\\    add_header X-Served-By ${NGINX_HOSTNAME} always;" "$DEFAULT_SITE"
fi

rm -f /etc/nginx/conf.d/0-custom-header.conf

nginx -t
systemctl restart nginx