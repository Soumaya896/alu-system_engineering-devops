#!/usr/bin/env bash
# Configures nginx to send a custom X-Served-By header (value = server hostname)

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

$SUDO apt-get update -y
$SUDO apt-get install -y nginx

if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    $SUDO sed -i '/^\s*server_name _;/a\    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default
fi

$SUDO service nginx restart
